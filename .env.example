# Port the local API server listens on
PORT=9777

# Where persistent browser profiles (logged-in sessions) are stored.
# Defaults to ~/.config/llm-whisperer/profiles when unset.
# PROFILES_DIR=./profiles

# Run browsers headless (true) or with a visible window (false).
# Keep false while getting started so you can see it work.
HEADLESS=false

# Which browser the profile-mode launcher uses.
#   chromium (default) — Playwright's bundled Chromium, zero install.
#   chrome             — your locally-installed Google Chrome. Recommended:
#                        passes Google's "this browser may not be secure" login
#                        check that the bundled Chromium often fails.
#   msedge             — locally-installed Microsoft Edge.
# (Ignored in CDP mode — there the browser is whatever you started.)
# WSPR_BROWSER_CHANNEL=chrome

# Optional API key. When set, every endpoint except GET /health requires it,
# passed as `Authorization: Bearer <key>` or `x-api-key: <key>`.
# Leave unset/commented for an open API (fine for localhost).
# WSPR_API_KEY=change-me

# --- Credential vault + autonomous login ---
# Passphrase that unlocks the encrypted credential vault at
# $PROFILES_DIR/credentials.enc (AES-256-GCM, scrypt). If unset, `wspr creds`
# prompts for it and the /ui dashboard can unlock it at runtime.
# WSPR_VAULT_KEY=change-me
#
# Auto-login when a session lapses (default true when a vault is unlocked).
# A credential is tried once per process; never twice — repeated failures lock
# accounts. Set to false to stay on the manual `wspr login` flow.
# WSPR_AUTO_LOGIN=true
#
# Separate token for the /ui credentials dashboard (independent of WSPR_API_KEY).
# If unset, a random one is generated at startup and printed as a click-through URL.
# WSPR_UI_TOKEN=change-me

# Bind the HTTP server to a specific address. Default 127.0.0.1 (loopback only,
# so the credentials dashboard is not reachable from your LAN).
# WSPR_HOST=127.0.0.1

# --- Driving a coding agent (opencode, Cline, …) ---
# See docs/clients.md. These matter mainly for the browser providers, whose
# conversation lives in a Chromium tab while the client is stateless.

# Request body limit. An agent sends whole files back in tool results, so
# Express's 1mb default is far too small. Default 32mb.
# WSPR_MAX_BODY=32mb

# Concurrent tabs per provider x profile. With conversation affinity each tab
# holds one conversation, so this is also how many conversations a browser
# provider keeps hot. Agent clients interleave a main loop with title and
# summary calls — 3 or more is comfortable. Default 2.
# WSPR_MAX_PAGES=3

# How a browser provider chooses between continuing the tab's thread and
# replaying the transcript into a fresh one.
#   auto   (default) continue only when the tab provably holds the client's
#          history; otherwise replay. The only correct setting for an agent.
#   tab    always continue — wspr's historical behaviour.
#   replay always start fresh and re-send everything. Slow, but a good way to
#          tell a provider problem apart from an affinity problem.
# WSPR_CONTINUITY=auto

# Whether the conversation key covers system-message *content*. Agents rebuild
# their system prompt every request with volatile context (cwd, today's date,
# git status), so hashing it would replay the whole transcript every turn.
# Default ignore; set hash only if your client's system prompt is stable.
# WSPR_AFFINITY_SYSTEM=ignore

# How tool JSON Schemas are rendered into the browser prompt preamble:
# compact (default), json, or pretty. Compact exists because a dozen
# pretty-printed agent tool schemas overflow a chat box.
# WSPR_TOOL_SCHEMA_STYLE=compact

# --- Real provider API keys (OpenAI-compatible) ---
# Set these to use the API-key providers in providers.yaml (openai, gemini,
# …) which call the real HTTP API instead of driving a browser. The env var name
# must match the provider's `keyEnv`. Each is only needed if you use that provider.
# OPENAI_API_KEY=sk-...     # paid — https://platform.openai.com/api-keys
# GEMINI_API_KEY=...        # free tier — https://aistudio.google.com/apikey
# GROQ_API_KEY=...          # free tier — https://console.groq.com/keys
# OPENROUTER_API_KEY=...    # free models — https://openrouter.ai/keys
# CEREBRAS_API_KEY=...      # free tier — https://cloud.cerebras.ai
# MISTRAL_API_KEY=...       # free tier — https://admin.mistral.ai/organization/api-keys
# Cloudflare Workers AI needs BOTH a token and your account id (used in the URL).
# dash.cloudflare.com -> AI -> AI Gateway -> "Create Authentication Token":
# CLOUDFLARE_API_TOKEN=...    # the token from that button
# CLOUDFLARE_ACCOUNT_ID=...   # the <ACCOUNT_ID> shown in the sample curl on that page
# DigitalOcean Serverless Inference — control panel -> Inference -> Manage ->
# Model Access Keys -> create a key:
# DIGITALOCEAN_INFERENCE_KEY=...  # the model access key

# --- CDP mode (recommended): connect to YOUR real Chrome ---
# 1. Start Chrome with: pnpm run chrome
#    (this opens your real Chrome with all your Google accounts)
# 2. Set CDP_URL here:
# CDP_URL=http://localhost:9222
#
# Leave CDP_URL unset to use profile mode (isolated Playwright Chromium,
# requires pnpm run login <provider> once per service).
